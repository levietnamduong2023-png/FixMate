{
  "name": "fixmate",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Home Repair Service Platform MVP",
  "scripts": {
    "start": "node BE/src/server.js",
    "dev": "concurrently -n BE,FE -c cyan,magenta \"npm:dev:be\" \"npm:dev:fe\"",
    "dev:be": "node --watch BE/src/server.js",
    "dev:fe": "vite --config FE/vite.config.js",
    "build": "vite build --config FE/vite.config.js",
    "test": "node --test BE/test/domain.test.js BE/test/integration.test.js",
    "check": "node --check BE/src/app.js && node --check BE/src/models/index.js && node --check BE/src/routes/requests.js && npm run build",
    "seed": "node BE/src/seed.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "vite": "^8.2.2"
  }
}
